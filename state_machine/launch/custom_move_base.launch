<launch>
  <node pkg="move_base" type="move_base" name="move_base" output="screen">
    <param name="base_global_planner" value="navfn/NavfnROS" />
    <param name="base_local_planner" value="dwa_local_planner/DWAPlannerROS" />

    <rosparam file="$(find state_machine)/config/global_costmap.yaml" command="load" ns="global_costmap" />
    <rosparam file="$(find state_machine)/config/local_costmap.yaml" command="load" ns="local_costmap" />
    <rosparam file="$(find state_machine)/config/base_local_planner.yaml" command="load" />
  </node>
</launch>
