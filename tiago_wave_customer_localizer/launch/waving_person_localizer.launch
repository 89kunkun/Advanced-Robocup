<launch>
  <!-- Node for 3D localization of waving customers -->
  <node pkg="tiago_wave_customer_localizer"
        type="waving_person_localizer.py"
        name="waving_person_localizer"
        output="screen">

    <!-- Camera topic configuration (adjust according to actual Tiago setup) -->
    <param name="depth_topic"        value="/xtion/depth_registered/image_raw"/>
    <param name="camera_info_topic"  value="/xtion/rgb/camera_info"/>
    <param name="bbox_topic"         value="/wave_customer_detect/waving_person_bbox"/>
    
    <!-- TF coordinate frame configuration -->
    <param name="camera_frame"       value="xtion_rgb_optical_frame"/>
    <param name="map_frame"          value="map"/>
    <param name="base_frame"         value="base_link"/>
    
    <!-- Navigation parameters -->
    <param name="target_distance"      value="1.3"/>  <!-- Target distance between robot and customer (meters) -->
    <param name="use_move_base"        value="false"/>  <!-- Whether to send move_base goal directly -->
    <param name="navigation_cooldown"  value="10.0"/>  <!-- Interval between navigation goal sends (seconds) -->
  </node>
</launch>
